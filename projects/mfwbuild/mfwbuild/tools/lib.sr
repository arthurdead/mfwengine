#include "bases/windows_tool.sr"
#include "bases/wine_tool.sr"

lib
{
	output {
		"/OUT",
	}

	builder::macros {
		output_ext ".lib"
		is_ar false
	}

	single_input

	patterns {
		"*.obj"
	}

	options_map {
		$(needs_equal,file)
		output "/OUT"
		nologo "/nologo"
	}

#if MFW_OS == MFW_OS_LINUX
	#define MSVCVER "14.26.28801"
	#define ARCH "x64"

	shell "${HOME}/wine/msvc-wine/dist_release/vc/tools/msvc/MSVCVER/bin/Hostx64/ARCH/lib.exe"
#else
	#error
#endif
}
