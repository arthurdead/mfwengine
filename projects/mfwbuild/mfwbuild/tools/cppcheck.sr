#include "bases/cpp_source_patterns.sr"
#include "bases/cpp_header_patterns.sr"

cppcheck : base_tool
{
	equal_char '='

	options_map {
		$(folders,needs_values)
		includes_paths "-I"
		$(files,needs_values,needs_equal)
		forced_includes "--include"
		$(needs_equal)
		platform "--platform"
		$(needs_equal)
		standard "--std"
		$(folder,needs_equal)
		output "--cppcheck-build-dir"
		$(needs_equal,needs_values)
		checks "--enable"
		preprocessor_definitions "-D"
		$(needs_equal,needs_values)
		suppress "--suppress"
		inconclusive "--inconclusive"
		inline_suppress "--inline-suppr"
		$(files,folders)
		ignore "-i"
		quiet "--quiet"
		$(needs_equal)
		template "--template"
		$(needs_equal,file)
		compile_commands "--project"
	}

	shell "cppcheck"
}