#include "cpp_compiler.sr"
#include "unix_linker_patterns.sr"

base_tool
{
	output "${file_basename}.o" {
		"-o",
		"--output"
	}

	builder::macros {
		output_ext ".o"
		is_unix_compiler true
		is_cl false
	}

	patterns {
		"*.S",
	}

	output_regex {
		info {
			"note:"
			"messages:"
			"In file included "
			"In function "
			"In member function "
			"In instantiation of "
		}
		warning {
			"warning:"
		}
		error {
			"error:"
			"Stack dump:"
		}
	}

	includes_paths {
		"--include-directory"
		"-i"
	}

	preprocessor_definitions {
		"--define-macro"
		"-D"
	}

	forced_includes {
		"--include"
		"-include"
	}

	standard "-std"

	warnings_as_errors "-Werror"

	options_map {
		$(files,needs_values)
		forced_includes "-include"
		$(needs_values)
		preprocessor_definitions "-D"
		no_linking "-c"
		$(file)
		output "-o"
		$(folders)
		includes_paths "-I"
		$(needs_equal)
		standard "-std" {
			"c++latest" "c++2a"
			"c++20" "c++2a"
		}
		warning_errors "-Werror"
		fatal_errors "-Wfatal-errors"
		pendatic "-Wpedantic"
		pendatic_errors "-pedantic-errors"
		all_warnings "-Wall"
		extra_warnings "-Wextra"
		$(remove)
		nologo
		char8_t "-fchar8_t"
		$(needs_values,no_space)
		disable_warnings "-Wno-"
		shared "-shared"
		pic "-fPIC"
		pie "-fPIE"
		$(folders,no_space)
		lib_directories "-L"
		$(needs_values,no_space)
		libraries "-l"
	}

$if cmdline.value("ccache")
	subprocess
	{
		shell "ccache"
	}
$endif
}
