base_solution
{
	build_set {
	$if plugin_name == "vscode"
		os {
		#if MFW_OS == MFW_OS_LINUX
			linux
		#elif MFW_OS == MFW_OS_WINDOWS
			windows
		#else
			#error
		#endif
		}
		configuration::debug
	$else
		os {
			//windows
			linux
		}
		configuration {
			debug,
			//release
		}
	$endif
		platform::x86_64
	}

	plugin::build {
	$if plugin_name == "vscode"
		command "\"${mfwbuilder}\" --plugins=\"process\" --solutions=\"${solution_name}\" --path=\"${path_folder}\" --os=\"${os}\" --platform=\"${platform}\" --configuration=\"${configuration}\" --jobs=6"
	$endif
	}

	builder {
		pre_generate {
		$if plugin_name == "vscode"
			$(message="Generating compile_commands.json")
			"\"${mfwbuilder}\" --plugins=\"process\" --solutions=\"${solution_name}\" --path=\"${path_folder}\" --sections=\"compiler\" --only_compile_commands"
		$endif
		}
		macros {
			root_folder "${path_folder}/../.."
			source_folder "${root_folder}/source"
			package_folder "${root_folder}/package"
			thirdparty_folder "${root_folder}/thirdparty"
			intermediary_folder "${plugin_data_folder}/${solution_name}/${project_name}/${tool_name}_${platform}_${os}_${configuration}"
			base_dependency_folder "${data_folder}/process/${solution_name}/${dependency_name}"
		}
	}

	tools {
	$if os == "windows"
		//compiler cl
		compiler clang_cl
		//linker link
		linker lld_link
		archiver lib
	$else
		compiler "g++"
		linker ld_gold
		archiver gcc_ar
	$endif
	}
}
