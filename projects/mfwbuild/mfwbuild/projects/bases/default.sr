standards {
	cpp11::compiler::options {
		standard "c++11"
	}
	cpp14::compiler::options {
		standard "c++14"
	}
	cpp17::compiler::options {
		standard "c++17"
	}
	cpp20::compiler::options {
		standard "c++20"
	}
	cpp11|cpp14|cpp17 {
		compiler::options {
			char8_t
		}
	}
}

crt {
$if os == "linux"
	static {
		"/usr/lib/crt1.o"
	}
	shared {
		"/usr/lib/Scrt1.o"
	}
	shared|static {
		"/usr/lib/crti.o"
	}
	static {
		"/usr/lib/gcc/x86_64-pc-linux-gnu/9.3.0/crtbegin.o"
	}
	shared {
		"/usr/lib/gcc/x86_64-pc-linux-gnu/9.3.0/crtbeginS.o"
	}
	shared|static {
		"-lstdc++"
		"-lm"
	}
	shared {
		"-lgcc_s"
	}
	static|shared {
		"-lgcc"
		"-lc"
	}
	static {
		"/usr/lib/gcc/x86_64-pc-linux-gnu/9.3.0/crtend.o"
	}
	shared {
		"/usr/lib/gcc/x86_64-pc-linux-gnu/9.3.0/crtendS.o"
	}
	shared|static {
		"/usr/lib/crtn.o"
	}
$endif
}

base_project {
	compiler
	archiver ignore
	linker ignore
	plugin::build {
	$if plugin_name == "vscode"
		command "\"${mfwbuilder}\" --plugins=\"process\" --solutions=\"${solution_name}\" --projects=\"${project_name}\" --path=\"${path_folder}\" --os=\"${os}\" --platform=\"${platform}\" --configuration=\"${configuration}\" "
	$endif
	}
	builder {
		pre_generate {
		$if plugin_name == "vscode"
			$(message="Generating compile_commands.json")
			"\"${mfwbuilder}\" --solutions=\"${solution_name}\" --projects=\"${project_name}\" --sections=\"compiler\" --plugins=\"process\" --path=\"${path_folder}\" --os=\"${os}\" --platform=\"${platform}\" --configuration=\"${configuration}\" --only_compile_commands"
		$endif
		}
	}
	compiler {
		builder {
		$if configuration == "release"
			unity_build
		$endif
		}
		options {
			nologo
			no_linking
		$if is_unix_compiler
			"-fvisibility=hidden"
			"-fvisibility-inlines-hidden"
		$endif
		$if configuration == "debug"
			//warning_errors
			fatal_errors
			all_warnings
			pendatic
			pendatic_errors
			extra_warnings
		$endif
			preprocessor_definitions {
			$if configuration == "debug"
				DEBUG,_DEBUG
			$else
				NDEBUG,_NDEBUG
			$endif
			$if os == "windows"
				_WIN32_WINNT_WIN10_TH2 _WIN32_WINNT_WIN10
				_WIN32_WINNT_WIN10_RS1 _WIN32_WINNT_WIN10
				_WIN32_WINNT_WIN10_RS2 _WIN32_WINNT_WIN10
				_WIN32_WINNT_WIN10_RS3 _WIN32_WINNT_WIN10
				_WIN32_WINNT_WIN10_RS4 _WIN32_WINNT_WIN10
				_WIN32_WINNT_WIN10_RS5 _WIN32_WINNT_WIN10
			$endif
				UNICODE,_UNICODE
			}
			disable_warnings {
			$if is_cl
				"4577","4530","4820"
			$else
				"expansion-to-defined"
			$endif
			}
		}
	}
	linker {
		implib {
		$if platform == "x86_64"
			arch "x86_64"
		$elif platform == "x86"
			arch "i386"
		$elif platform == "armv7"
			arch "arm"
		$elif platform == "armv8"
			arch "aarch64"
		$endif
		}
		options {
			nologo
		$if os == "linux"
			"-dynamic-linker" "/lib64/ld-linux-x86-64.so.2"
			"--hash-style=gnu"
			"-m" "elf_x86_64"
			"--build-id"
		$endif
		}
	}
	archiver::options {
		nologo
	$if is_ar
		"-r","-c","-s"
	$endif
	}
	compiler::options {
		output "${intermediary_folder}/${file_basename}${output_ext}"
	}
	archiver|linker {
		options {
			output "${intermediary_folder}/${project_name}${output_ext}"
		}
	}
}

output_executable|output_shared {
	linker ""
	compiler {
		output_tool linker
	}
}

output_static {
	archiver ""
	compiler {
		options {
			pic
		}
		output_tool archiver
	}
	builder::dependency::linker {
		files {
		$if !is_self
			$if os == "linux"
			"${base_dependency_folder}/${archiver}_${platform}_${os}_${configuration}/${dependency_name}.a"
			$endif
		$endif
		}
	}
}

output_shared {
	builder::dependency::linker {
		files {
		$if !is_self
			$if os == "linux"
			//"${base_dependency_folder}/${linker}_${platform}_${os}_${configuration}/${dependency_name}.so"
			$endif
		$endif
		}
	}
	compiler::options {
		pic
		shared
		preprocessor_definitions {
			_SHARED,SHARED
		}
	}
	linker {
		options {
			shared
			#pragma insert(file_root.crt.shared)
		}
		options -= "/usr/lib/crt1.o"
		options -= "/usr/lib/Scrt1.o"
		builder::macros {
		$if os == "windows"
			output_ext ".dll"
		$else
			output_ext ".so"
		$endif
		}
	}
}

output_executable {
	compiler::options {
		pie
		pic
	}
	linker {
		options {
			pie
			#pragma insert(file_root.crt.shared)
		}
		builder::macros {
		$if os == "windows"
			output_ext ".exe"
		$else
			output_ext ""
		$endif
		}
	}
}

output_static::compiler::options::preprocessor_definitions {
	_LIB,LIB
}

output_executable_console : output_executable {
	compiler::options::preprocessor_definitions {
		_CONSOLE,CONSOLE
	}
}

output_executable_windows : output_executable {
	compiler::options::preprocessor_definitions {
		_WINDOWS,WINDOWS
	}
}
