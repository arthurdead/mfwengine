standards {
	cpp11::compiler::options {
	$if os == "linux"
		standard "gnu++11"
	$else
		standard "c++11"
	$endif
	}
	cpp14::compiler::options {
	$if os == "linux"
		standard "gnu++14"
	$else
		standard "c++14"
	$endif
	}
	cpp17::compiler::options {
	$if os == "linux"
		standard "gnu++17"
	$else
		standard "c++17"
	$endif
	}
	cpp20::compiler::options {
	$if os == "linux"
		standard "gnu++20"
	$else
		standard "c++20"
	$endif
	}
	cpp11|cpp14|cpp17 {
		compiler::options {
			char8_t
		}
	}
}

crt {
$if os == "linux"
	static {
		$(file)
		"/usr/lib/crt1.o"
	}
	shared {
		$(file)
		"/usr/lib/Scrt1.o"
	}
	shared|static {
		$(file)
		"/usr/lib/crti.o"
	}
	static {
		$(file)
		"${gcc_lib_dir}/crtbegin.o"
	}
	shared {
		$(file)
		"${gcc_lib_dir}/crtbeginS.o"
	}
	shared|static {
		"-lstdc++"
		"-lm"
	}
	shared {
		"-lgcc_s"
	}
	static|shared {
		"-lgcc"
		"-lc"
	}
	static {
		$(file)
		"${gcc_lib_dir}/crtend.o"
	}
	shared {
		$(file)
		"${gcc_lib_dir}/crtendS.o"
	}
	shared|static {
		$(file)
		"/usr/lib/crtn.o"
	}
$endif
}

base_project {
	compiler
	archiver ignore
	linker ignore
	plugin::build {
	$if plugin_name == "vscode"
		command "\"${mfwbuilder}\" --plugins=\"process\" --solutions=\"${solution_name}\" --projects=\"${project_name}\" --path=\"${path_folder}\" --os=\"${os}\" --platform=\"${platform}\" --configuration=\"${configuration}\" "
	$endif
	}
	compiler {
		builder {
		$if configuration == "release"
			unity_build
		$endif
		}
		options {
			nologo
			no_linking
		$if is_unix_compiler
			"-fvisibility=hidden"
			"-fvisibility-inlines-hidden"
			"-g"
		$endif
			preprocessor_definitions {
			$if os == "windows"
				_WIN32_WINNT_WIN10_TH2 _WIN32_WINNT_WIN10
				_WIN32_WINNT_WIN10_RS1 _WIN32_WINNT_WIN10
				_WIN32_WINNT_WIN10_RS2 _WIN32_WINNT_WIN10
				_WIN32_WINNT_WIN10_RS3 _WIN32_WINNT_WIN10
				_WIN32_WINNT_WIN10_RS4 _WIN32_WINNT_WIN10
				_WIN32_WINNT_WIN10_RS5 _WIN32_WINNT_WIN10
			$endif
			}
			disable_warnings {
			$if is_cl
				"4577","4530","4820"
			$else
				"expansion-to-defined"
			$endif
			}
		}
	}
	linker {
		implib {
		$if platform == "x86_64"
			arch "x86_64"
		$elif platform == "x86"
			arch "i386"
		$elif platform == "armv7"
			arch "arm"
		$elif platform == "armv8"
			arch "aarch64"
		$endif
		}
		options {
			nologo
		$if is_unix_linker
			$if os == "linux"
			"-dynamic-linker" "/lib64/ld-linux-x86-64.so.2"
			$endif
			"--hash-style=gnu"
			"-m" "elf_x86_64"
			"--build-id"
			"--export-dynamic"
			$if tool_name == "ld"
			"--exclude-all-symbols"
			$endif
			"--error-unresolved-symbols"
			"--as-needed"
			"--no-export-dynamic"
			"--no-allow-shlib-undefined"
			//"--no-undefined"
		$endif
		}
	}
	archiver::options {
		nologo
	$if is_ar
		"-r","-c","-s"
	$endif
	}
	compiler::options {
		output "${intermediary_folder}/${file_filter}/${file_basename}${output_ext}"
	}
	archiver|linker {
		options {
			output "${intermediary_folder}/${project_name}${output_ext}"
		}
	}
}

output_executable|output_shared {
	linker ""
	compiler {
		output_tool linker
	}
}

output_static {
	archiver ""
	compiler {
		options {
			pic
		}
		output_tool archiver
	}
	builder::dependency::linker {
		files {
		$if os == "linux"
			"${base_dependency_folder}/${archiver}_${platform}_${os}_${configuration}/${dependency_name}.a"
		$endif
		}
	}
}

output_shared {
	builder::dependency::linker {
		files {
		$if os == "linux"
			//"${base_dependency_folder}/${linker}_${platform}_${os}_${configuration}/${dependency_name}.so"
		$endif
		}
	}
	compiler::options {
		pic
	}
	linker {
		options {
			shared
			#pragma insert(file_root.crt.shared)
		}
		options -= "/usr/lib/crt1.o"
		options -= "/usr/lib/Scrt1.o"
		builder::macros {
		$if os == "windows"
			output_ext ".dll"
		$else
			output_ext ".so"
		$endif
		}
	}
}

output_executable {
	compiler::options {
		pie
		pic
	}
	linker {
		options {
			pie
			#pragma insert(file_root.crt.shared)
		}
		builder::macros {
		$if os == "windows"
			output_ext ".exe"
		$else
			output_ext ""
		$endif
		}
	}
}

output_executable_console : output_executable
output_executable_windows : output_executable
