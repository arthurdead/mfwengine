#include "bases/engine_project.sr"

//#define __MFW_ENABLE_IBERTY
//#define __MFW_ENABLE_ASMJIT
//#define __MFW_USE_CORE_DELAY_LOADED

core : base_project, standards.cpp20, output_shared
{
	builder {
		dependency {
			linker {
				options {
					libraries {
					$if os == "linux"
						dl
					$endif
					}
				}
				files {
			#ifndef __MFW_USE_CORE_DELAY_LOADED
				$if !is_self && os == "linux"
					"${base_dependency_folder}/${linker}_${platform}_${os}_${configuration}/${dependency_name}.so"
				$endif
			#endif
				}
			}
		#ifdef __MFW_USE_CORE_DELAY_LOADED
			compiler {
				options::preprocessor_definitions {
				$if !is_self
					__MFW_CORE_IS_DELAY_LOADED
				$endif
				}
				files {
				$if !is_self && os == "linux"
					"${base_dependency_folder}/${linker}_${platform}_${os}_${configuration}/asm.S"
					"${base_dependency_folder}/${linker}_${platform}_${os}_${configuration}/load.c"
				$endif
				}
			}
		#endif
		}
		depends {
			stl
		}
	}
	linker {
	#ifdef __MFW_USE_CORE_DELAY_LOADED
		implib "${intermediary_folder}" {
			symbols {
				"*mfw*"
			}
		}
	#endif
		options {
			libraries {
		#ifdef __MFW_ENABLE_IBERTY
			$if os == "linux"
				iberty
			$endif
		#endif
			}
		}
	}
	compiler::options::preprocessor_definitions {
	#ifdef __MFW_ENABLE_ASMJIT
		__MFW_USE_ASMJIT
	#endif
	#ifdef __MFW_ENABLE_IBERTY
		__MFW_USE_IBERTY
	#endif
	}
}
