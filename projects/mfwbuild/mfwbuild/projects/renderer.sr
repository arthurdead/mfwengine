#include "bases/engine_project.sr"

renderer : base_project, standards.cpp20, output_shared
{
	builder {
		dependency::linker {
			files {
			$if os == "linux"
				"${shared_out_dir}/${dependency_name}.so"
			$endif
			}
		}
		depends {
			core::shared,
			stl
		}
	}
	compiler::options::preprocessor_definitions {
		MFW_APPLICATION_MAIN_DEFINED
	}
	linker::options::libraries {
	$if os == "linux"
		xcb
		X11
		//vulkan
		GL
		shaderc_shared
	$endif
	}
}
