test_proj {
	compiler {
		output_tool linker
		files {
			"/home/arthurdead/Desktop/temp/code/main.cpp"
		}
		options {
			"-c"
			$(file)
			"-o" "/home/arthurdead/Desktop/temp/code/main.o"
			"-fPIC"
			"-frtti"
			"-O0"
		}
	}
	linker {
		implib "${intermediary_folder}" {
			arch "x86_64"
		}
		options {
			$(file)
			"-o" "/home/arthurdead/Desktop/temp/code/main.so"
			"-shared"
		}
	}
}